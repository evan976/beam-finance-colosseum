# Load automatically via dotenv in hardhat.config.ts (copy to .env — never commit).

# --- Deployer (0x-prefixed hex). Used for Sepolia and EDU Chain testnet.
# Prefer DEPLOY_PRIVATE_KEY; SEPOLIA_PRIVATE_KEY is still supported.
DEPLOY_PRIVATE_KEY=
SEPOLIA_PRIVATE_KEY=

# --- Sepolia
SEPOLIA_RPC_URL=

# --- EDU Chain Testnet (Open Campus Codex, chain id 656476)
EDU_CHAIN_RPC_URL=

# --- 0G Galileo testnet (chain id 16602) — default deploy target for Beam EVM
OG_TESTNET_RPC_URL=

# --- 0G Mainnet (chain id 16661) — https://docs.0g.ai/developer-hub/mainnet/mainnet-overview
OG_MAINNET_RPC_URL=

# Optional: Etherscan (Sepolia)
ETHERSCAN_API_KEY=

# Optional: Blockscout API key if edu-chain-testnet verification requires it
BLOCKSCOUT_API_KEY=

# Optional: Chainscan (0G mainnet / Galileo testnet)
OG_CHAINSCAN_API_KEY=
OG_GALILEO_CHAINSCAN_API_KEY=

# BeamFinance constructor: true = only whitelisted addresses may createTreasury
BEAM_ENABLE_WHITELIST=false

# Comma-separated addresses when BEAM_ENABLE_WHITELIST=true
BEAM_INITIAL_WHITELIST=

# After deploy, for verify scripts (must match constructor args above)
BEAM_FINANCE_ADDRESS=

# --- Deploy test USDT-like token (MockERC20Mintable) + mint
#   bun run deploy:mock-token:edu-testnet
# MOCK_TOKEN_NAME=Test USDT
# MOCK_TOKEN_SYMBOL=USDT
# MOCK_TOKEN_DECIMALS=6
# MOCK_MINT_TO=0x...          # default: deployer wallet
# MOCK_MINT_AMOUNT=1000000    # human units (1_000_000 with 6 decimals = 1 USDT)
