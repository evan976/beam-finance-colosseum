# Solana RPC endpoint
# Helius (recommended): https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Public fallback:       https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Cluster name: localnet | devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Public app URL used for metadata and canonical links
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Explorer base URL used for transaction links
NEXT_PUBLIC_EXPLORER_URL=https://explorer.solana.com

# Optional UI restriction. The Anchor program currently runs in open mode.
NEXT_PUBLIC_ADMIN_WHITELIST=

# DeepSeek API key (server-side only)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
